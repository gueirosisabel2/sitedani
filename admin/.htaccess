Options -Indexes

<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, private, max-age=0"
  Header always set Pragma "no-cache"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

<FilesMatch "^(bootstrap|config\.local|config\.local\.example)\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(?:bak|dist|ini|log|sql|tmp)$">
  Require all denied
</FilesMatch>
